{
  "hooks": {
    "preToolUse": [
      {
        "name": "scope-guard",
        "path": "/path/to/arbor/hooks/scope-guard.py",
        "toolMatchers": ["Write", "Edit", "Bash"],
        "description": "Enforces file scope restrictions on remote agents. Set ARBOR_SCOPE env var to comma-separated paths."
      }
    ]
  }
}
